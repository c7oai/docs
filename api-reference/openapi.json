              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProvisioningCollectionResponse" },
                "examples": {
                  "example": {
                    "value": [
                      { "id": "user-001", "data": { "email": "owner@alpha.test", "role": "owner" } },
                      { "id": "user-002", "data": { "email": "viewer@alpha.test", "role": "viewer" } }
